{
  "name": "@jerryliang122/openclaw-qqbot",
  "version": "1.0.1",
  "description": "QQ Bot channel plugin for OpenClaw (independently maintained fork)",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "skills",
    "scripts",
    "index.ts",
    "preload.cjs",
    "tsconfig.json",
    "tsup.config.ts",
    "openclaw.plugin.json"
  ],
  "openclaw": {
    "id": "openclaw-qqbot",
    "extensions": [
      "./preload.cjs"
    ],
    "channel": {
      "id": "qqbot",
      "label": "QQ Bot"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint:runtime": "npx tsx src/adapter/lint.ts"
  },
  "dependencies": {
    "@tencent-connect/qqbot-connector": "1.2.0",
    "@tencent-connect/qqbot-nodejs": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "openclaw": "2026.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "tsx": "^4.23.13"
  },
  "peerDependencies": {
    "@tencent-connect/qqbot-connector": "1.2.0",
    "openclaw": ">=2026.9.2"
  },
  "homepage": "https://github.com/jerryliang122/qqbot-openclaw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jerryliang122/qqbot-openclaw.git"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true
  }
}
