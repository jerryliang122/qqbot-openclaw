                "audioFormatPolicy": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "音频格式策略：控制哪些格式可跳过转换",
                  "properties": {
                    "sttDirectFormats": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "STT 模型直接支持的音频格式（入站跳过 SILK→WAV 转换）"
                    },
                    "uploadDirectFormats": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "QQ 平台可直传的音频格式（出站跳过→SILK 转换，默认 .wav/.mp3/.silk）"
                    },
                    "transcodeEnabled": {
                      "type": "boolean",
                      "description": "是否启用语音转码（默认 true；环境无 ffmpeg 时可关掉直接发文件）"
                    }
                  }
                },
                "urlDirectUpload": {
                  "type": "boolean",
                  "description": "是否启用公网 URL 直传"
                },
                "defaultRequireMention": {
                  "type": "boolean",
                  "description": "群消息是否默认需要 @机器人才响应"
                },
                "groupCoalesce": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "群消息合并配置（账号级）",
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "description": "是否启用群消息合并（默认 true）"
                    }
                  }
                },
                "deliverDebounce": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "出站消息合并回复（debounce）配置",
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "description": "是否启用合并回复（默认 true）"
                    },
                    "windowMs": {
                      "type": "number",
                      "minimum": 0,
                      "description": "合并窗口时长毫秒数（默认 1500）"
                    },
                    "maxWaitMs": {
                      "type": "number",
                      "minimum": 0,
                      "description": "最大等待时长毫秒数，从第一条 deliver 起算，超过强制发送（默认 8000）"
                    },
                    "separator": {
                      "type": "string",
                      "description": "合并文本之间的分隔符（默认 \"\\n\\n---\\n\\n\"）"
                    }
                  }
                },
                "typing": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "\"正在输入\"指示器配置（仅 C2C 私聊生效）",
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "description": "是否启用指示器（默认 true）"
                    },
                    "intervalMs": {
                      "type": "number",
                      "minimum": 20000,
                      "description": "续期间隔毫秒数（默认 20000，受 QPS 限制不低于 20000）"
                    }
                  }
                },
                "inboundDebounce": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "私聊入站消息防抖合并（仅 C2C 生效）",
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "description": "是否启用防抖合并（默认 true）"
                    },
                    "debounceMs": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 60000,
                      "description": "防抖窗口毫秒数（0=关闭；默认 3000，钳制范围 [0, 60000]）"
                    }
                  }
                },
                "commands": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "指令面板配置（openclaw 原生指令 → QQ Bot 指令面板自动注册）",
                  "properties": {
                    "native": {
                      "type": "boolean",
                      "description": "是否自动注册原生指令到指令面板（默认 true）"
                    }
                  }
                },
                "streaming": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "流式消息配置（仅 C2C 私聊支持流式 API）",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "partial",
                        "off"
                      ],
                      "description": "流式模式：partial=打字机效果 | off=关闭（默认 off）"
                    },
                    "sendMode": {
                      "type": "string",
                      "enum": [
                        "stream",
                        "static"
                      ],
                      "description": "文本下发通道（仅 mode=partial 生效）：stream=流式打印机 | static=结束时整条发送"
                    }
                  }
                },
                "progressCard": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Progress Card（进度卡片）配置",
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "description": "总开关（默认 true）"
                    },
                    "scope": {
                      "type": "string",
                      "enum": [
                        "c2c",
                        "group",
                        "both"
                      ],
                      "description": "生效范围（默认 c2c）"
                    },
                    "minIntervalMs": {
                      "type": "number",
                      "minimum": 0,
                      "description": "两次卡片消息的最小间隔毫秒数（默认 1500）"
                    },
                    "maxPerTurn": {
                      "type": "number",
                      "minimum": 0,
                      "description": "每个 turn 最多发送的卡片条数（默认 3）"
                    },
                    "maxLines": {
                      "type": "number",
                      "minimum": 0,
                      "description": "checklist 最多渲染行数（默认 8；超出时压缩为完成数 + 当前步 + 待办尾部）"
                    },
                    "reserveQuota": {
                      "type": "number",
                      "minimum": 0,
                      "description": "为最终回复保留的被动配额槽（默认 1）：剩余槽位 ≤ 此值则跳过发卡，保证正文优先"
                    }
                  }
                },
                "userAgentSuffix": {
                  "type": "string",
                  "description": "User-Agent 尾部追加内容"
                },
                "mediaMaxMb": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "入站媒体解码大小上限（MB，框架通用字段；setup 流程会写入默认 200）"
                },
                "stt": {
                  "type": "object",
                  "description": "STT（语音转文字）历史遗留配置块——整块被忽略，保留仅为兼容旧配置",
                  "additionalProperties": true
                }
              }
            }
          },
          "defaultAccount": {
            "type": "string",
            "description": "默认账号 id（未指定时取第一个可用账号）"
          }
        }
      },
      "uiHints": {
        "": {
          "label": "QQ Bot",
          "help": "QQ Bot 官方 API 通道配置。凭据（appId / clientSecret）与凭据文件（clientSecretFile）互斥；私聊准入由 dmPolicy + allowFrom 控制，群聊由 groupPolicy + groupAllowFrom + groups 控制。"
        },
        "dmPolicy": {
          "label": "QQ Bot 私聊准入策略",
          "help": "pairing=配对码（推荐）| allowlist=白名单 | open=开放（需 allowFrom=[\"*\"]）| disabled=关闭私聊。"
        },
        "allowFrom": {
          "label": "QQ Bot 私聊白名单",
          "help": "允许私聊的用户 openid 列表。openid 按账号隔离——A 账号的 openid 在 B 账号无效。"
        },
        "groupPolicy": {
          "label": "QQ Bot 群消息策略",
          "help": "open=全响应 | allowlist=白名单 | disabled=不响应。注意：群主在 QQ 客户端选的推送模式（AT 纯模式 / AT+最近N / 全量模式）插件不可控。"
        },
        "groupAllowFrom": {
          "label": "QQ Bot 群白名单",
          "help": "允许响应的群 openid 列表。群 openid 同样按账号隔离。"
        },
        "groups": {
          "label": "QQ Bot 群配置",
          "help": "按群 openid 索引的群级配置；\"*\" 为默认组。优先级：groups.{groupOpenid} > groups.* > 账号级 defaultRequireMention > true。"
        },
        "groups.*.requireMention": {
          "label": "需要 @ 才响应",
          "help": "该群是否需要 @机器人才响应（默认 true）。"
        },
        "groups.*.toolPolicy": {
          "label": "群内工具策略",
          "help": "full=全部工具 | restricted=限制敏感工具（默认）| none=禁止所有工具。"
        },
        "groups.*.historyMode": {
          "label": "群历史窗口模式",
          "help": "clear=每次回复后整清历史 | rolling=裁剪到最后一次 bot 发言之后的滚动窗口。"
        },
        "groups.*.unmentionedInbound": {
          "label": "未被 @ 消息的入站策略",
          "help": "user_request=维持现状（未 @ 消息只进历史）| room_event=作为房间事件进框架（AI 只读上下文，不自动回复）。"
        },
        "defaultRequireMention": {
          "label": "群默认需要 @",
          "help": "所有群是否默认需要 @机器人才响应（默认 true），仍可被群级配置覆盖。"
        },
        "rateLimit": {
          "label": "QQ Bot 限流",
          "help": "三层滑动窗口限流：perSender（默认 20 条/分钟）、perGroup（60 条/分钟）、global（300 条/分钟）。"
        },
        "transport": {
          "label": "消息接收传输方式",
          "help": "websocket=长连接（默认）| webhook=HTTP 回调（需公网可达地址）。"
        },
        "clientSecretFile": {
          "label": "QQ Bot AppSecret 文件",
          "help": "AppSecret 存文件时的路径。文件在账号启动时读一次；与内联 clientSecret 互斥（内联优先，文件被忽略）。"
        },
        "markdownSupport": {
          "label": "支持 Markdown",
          "help": "默认 true。关闭后按纯文本（msg_type=0）发送，同时消息引用改为带引用原文的引用块。"
        },
        "streaming": {
          "label": "流式消息",
          "help": "仅 C2C 私聊支持 QQ 流式 API。mode=partial 开启打字机效果；sendMode=static 则结束时整条发送。"
        },
        "progressCard": {
          "label": "进度卡片",
          "help": "把多步计划以 checklist 快照发到聊天。卡片只走被动回复（配额不足即丢弃，不烧主动消息预算）。"
        },
        "typing": {
          "label": "正在输入指示器",
          "help": "仅 C2C 私聊生效。intervalMs 受 QPS 限制，低于 20000 会被钳制。"
        },
        "inboundDebounce": {
          "label": "私聊入站防抖",
          "help": "仅 C2C 生效。QQ 私聊的文件与文字是两条独立消息，防抖把连续消息合并成一次 dispatch。debounceMs 钳制范围 [0, 60000]。"
        },
        "commands.native": {
          "label": "自动同步原生指令到指令面板",
          "help": "默认 true。把 openclaw 原生指令注册到 QQ Bot 指令面板；点击后指令文本填入输入框，以普通文本走斜杠指令路由。"
        },
        "urlDirectUpload": {
          "label": "公网 URL 直传",
          "help": "默认 true。平台自行拉取公网 URL；失败自动回退为插件下载后 Base64 上传。"
        },
        "accounts": {
          "label": "QQ Bot 多账号",
          "help": "每个账号一套凭据、网关与 token 缓存。openid 按账号隔离——A 账号的 openid 在 B 账号不可用。"
        },
        "defaultAccount": {
          "label": "默认账号",
          "help": "未显式指定账号时使用的账号 id。"
        },
        "capabilities.inlineButtons": {
          "label": "QQ Bot 内联按钮作用域",
          "help": "控制模型可用的按钮能力：off=关闭 | dm=仅私聊 | group=仅群 | all=全部 | allowlist=仅白名单会话（默认 allowlist）。"
        }
      },
      "label": "QQ Bot",
      "description": "QQ Bot channel configuration with message support, cron jobs, and proactive messaging.",
      "preferOver": [
        "qqbot"
      ]
    }
  }
}
