                        "type": "number"
                      }
                    ]
                  },
                  "description": "私聊白名单（openid）"
                },
                "groupPolicy": {
                  "type": "string",
                  "enum": [
                    "open",
                    "allowlist",
                    "disabled"
                  ],
                  "default": "allowlist",
                  "description": "群消息策略"
                },
                "groupAllowFrom": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  "description": "群白名单（groupOpenid）"
                },
                "transport": {
                  "type": "string",
                  "enum": [
                    "websocket",
                    "webhook"
                  ],
                  "default": "websocket",
                  "description": "消息接收传输方式"
                },
                "webhook": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "webhook 传输配置（transport=webhook 时生效）",
                  "properties": {
                    "path": {
                      "type": "string",
                      "description": "监听路径（默认 /qqbot/webhook）"
                    }
                  }
                },
                "groups": {
                  "type": "object",
