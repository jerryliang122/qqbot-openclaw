{
  "id": "openclaw-qqbot",
  "name": "OpenClaw QQ Bot",
  "description": "QQ Bot channel plugin with message support, cron jobs, and proactive messaging",
  "channels": [
    "qqbot"
  ],
  "extensions": [
    "./preload.cjs"
  ],
  "skills": [
    "skills/qqbot-channel"
  ],
  "contracts": {
    "tools": [
      "qqbot_platform_api",
      "qqbot_remind",
      "qqbot_secret_input"
    ]
  },
  "capabilities": {
    "proactiveMessaging": true,
    "cronJobs": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "appId": {
        "type": "string",
        "description": "QQ Bot AppID"
      },
      "clientSecret": {
        "type": "string",
        "description": "QQ Bot AppSecret"
      }
    }
  },
  "channelConfigs": {
    "qqbot": {
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "账号显示名"
          },
          "enabled": {
            "type": "boolean",
            "description": "是否启用该账号"
          },
          "appId": {
            "type": "string",
            "description": "QQ Bot AppID"
          },
          "clientSecret": {
            "type": "string",
            "description": "QQ Bot AppSecret（与 clientSecretFile 互斥）"
          },
          "clientSecretFile": {
            "type": "string",
            "description": "QQ Bot AppSecret 文件路径（与 clientSecret 互斥）"
          },
          "dmPolicy": {
            "type": "string",
            "enum": [
              "pairing",
              "allowlist",
              "open",
              "disabled"
            ],
            "default": "allowlist",
            "description": "私聊准入策略：pairing=配对码 | allowlist=白名单 | open=开放 | disabled=关闭"
          },
          "allowFrom": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            },
            "description": "私聊白名单（openid；dmPolicy=allowlist 时生效）"
          },
          "groupPolicy": {
            "type": "string",
            "enum": [
              "open",
              "allowlist",
              "disabled"
            ],
            "default": "allowlist",
            "description": "群消息策略：open=全响应 | allowlist=白名单 | disabled=不响应"
          },
          "groupAllowFrom": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            },
            "description": "群白名单（groupOpenid；groupPolicy=allowlist 时生效）"
          },
          "groups": {
            "type": "object",
            "description": "按群 openid 索引的群配置（\"*\" 为默认）",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "requireMention": {
                  "type": "boolean",
                  "description": "是否需要 @机器人才响应（默认 true）"
                },
                "ignoreOtherMentions": {
                  "type": "boolean",
                  "description": "忽略 @了其他用户但没 @bot 的消息（默认 false）"
                },
                "toolPolicy": {
                  "type": "string",
                  "enum": [
                    "full",
                    "restricted",
                    "none"
                  ],
                  "description": "群内 AI 可用工具范围（默认 restricted）"
                },
                "name": {
                  "type": "string",
                  "description": "群名称（用于 /bot-group-info 展示）"
                },
                "prompt": {
                  "type": "string",
                  "description": "群消息行为提示（PE）"
                },
                "historyLimit": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "群历史缓存条数（0 禁用，默认 20）"
                },
                "historyMode": {
                  "type": "string",
                  "enum": [
                    "clear",
                    "rolling"
                  ],
                  "description": "群历史清理时机：clear=每次回复后整清 | rolling=裁剪到最后一次 bot 发言后"
                },
                "unmentionedInbound": {
                  "type": "string",
                  "enum": [
                    "user_request",
                    "room_event"
                  ],
                  "description": "未被 @ 的群消息入站策略：user_request=仅进历史 | room_event=作为房间事件进框架"
                },
                "roomEventRequireMessageTool": {
                  "type": "boolean",
                  "description": "room_event 是否强制要求 message 工具可用（默认 true：不可用时降级回 user_request 并打 WARN；false=严格静默模式，由用户自行保证工具面）"
                },
                "tools": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "allow": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "工具白名单（非空时清单外工具一律不可用；room_event 群必须包含 message，否则该群失去唯一发声通道）"
                    },
                    "alsoAllow": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "在 allow 基础上追加允许的工具（allow 缺失时框架合成隐式全放行）"
                    },
                    "deny": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "显式禁用的工具（优先级最高；支持 * 通配）"
                    }
                  },
                  "description": "群级工具白名单（优先级高于 toolPolicy；未声明则按 toolPolicy 兜底）"
                },
                "coalesce": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "description": "是否启用群消息合并（默认 true）"
                    }
                  },
                  "description": "群消息合并配置（覆盖账号级）"
                }
              }
            }
          },
          "defaultRequireMention": {
            "type": "boolean",
            "description": "群消息是否默认需要 @机器人才响应（默认 true，优先级低于 groups.*.requireMention）"
          },
          "rateLimit": {
            "type": "object",
            "additionalProperties": false,
            "description": "三层限流（sender / group / global，默认启用保守阈值）",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "是否启用限流（默认 true）"
              },
              "perSender": {
                "type": "object",
                "additionalProperties": false,
                "description": "单发送者限流（默认 20 条/分钟）",
                "properties": {
                  "max": {
                    "type": "number",
                    "minimum": 0
                  },
                  "windowMs": {
                    "type": "number",
                    "minimum": 1
                  }
                }
              },
              "perGroup": {
                "type": "object",
                "additionalProperties": false,
                "description": "单群限流（默认 60 条/分钟，c2c 按 sender 归组）",
                "properties": {
                  "max": {
                    "type": "number",
                    "minimum": 0
                  },
                  "windowMs": {
                    "type": "number",
                    "minimum": 1
                  }
                }
              },
              "global": {
                "type": "object",
                "additionalProperties": false,
                "description": "全局限流（默认 300 条/分钟）",
                "properties": {
                  "max": {
                    "type": "number",
                    "minimum": 0
                  },
                  "windowMs": {
                    "type": "number",
                    "minimum": 1
                  }
                }
              }
            }
          },
          "transport": {
            "type": "string",
            "enum": [
              "websocket",
              "webhook"
            ],
            "default": "websocket",
            "description": "消息接收传输方式"
          },
          "webhook": {
            "type": "object",
            "additionalProperties": false,
            "description": "webhook 传输配置（transport=webhook 时生效）",
            "properties": {
              "path": {
                "type": "string",
                "description": "监听路径（默认 /qqbot/webhook）"
              }
            }
          },
          "systemPrompt": {
            "type": "string",
            "description": "系统提示词（会添加在用户消息前面）"
          },
          "markdownSupport": {
            "type": "boolean",
            "default": true,
            "description": "是否支持 markdown 消息（默认 true，设为 false 走纯文本）"
          },
          "audioFormatPolicy": {
            "type": "object",
            "additionalProperties": false,
            "description": "音频格式策略：控制哪些格式可跳过转换",
            "properties": {
              "sttDirectFormats": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "STT 模型直接支持的音频格式（入站跳过 SILK→WAV 转换）"
              },
              "uploadDirectFormats": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "QQ 平台可直传的音频格式（出站跳过→SILK 转换，默认 .wav/.mp3/.silk）"
              },
              "transcodeEnabled": {
                "type": "boolean",
                "description": "是否启用语音转码（默认 true；环境无 ffmpeg 时可关掉直接发文件）"
              }
            }
          },
          "urlDirectUpload": {
            "type": "boolean",
            "default": true,
            "description": "是否启用公网 URL 直传 QQ 平台（失败自动回退为下载后 Base64 上传）"
          },
          "groupCoalesce": {
            "type": "object",
            "additionalProperties": false,
            "description": "群消息合并配置（账号级）",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "是否启用群消息合并（默认 true）"
              }
            }
          },
          "deliverDebounce": {
            "type": "object",
            "additionalProperties": false,
            "description": "出站消息合并回复（debounce）配置",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "是否启用合并回复（默认 true）"
              },
              "windowMs": {
                "type": "number",
                "minimum": 0,
                "description": "合并窗口时长毫秒数（默认 1500）"
              },
              "maxWaitMs": {
                "type": "number",
                "minimum": 0,
                "description": "最大等待时长毫秒数，从第一条 deliver 起算，超过强制发送（默认 8000）"
              },
              "separator": {
                "type": "string",
                "description": "合并文本之间的分隔符（默认 \"\\n\\n---\\n\\n\"）"
              }
            }
          },
          "typing": {
            "type": "object",
            "additionalProperties": false,
            "description": "\"正在输入\"指示器配置（仅 C2C 私聊生效）",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "是否启用指示器（默认 true）"
              },
              "intervalMs": {
                "type": "number",
                "minimum": 20000,
                "description": "续期间隔毫秒数（默认 20000，受 QPS 限制不低于 20000）"
              }
            }
          },
          "inboundDebounce": {
            "type": "object",
            "additionalProperties": false,
            "description": "私聊入站消息防抖合并（仅 C2C 生效）",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "是否启用防抖合并（默认 true）"
              },
              "debounceMs": {
                "type": "number",
                "minimum": 0,
                "maximum": 60000,
                "description": "防抖窗口毫秒数（0=关闭；默认 3000，钳制范围 [0, 60000]）"
              }
            }
          },
          "commands": {
            "type": "object",
            "additionalProperties": false,
            "description": "指令面板配置（openclaw 原生指令 → QQ Bot 指令面板自动注册）",
            "properties": {
              "native": {
                "type": "boolean",
                "description": "是否自动注册原生指令到指令面板（默认 true）"
              }
            }
          },
          "streaming": {
            "type": "object",
            "additionalProperties": false,
            "description": "流式消息配置（仅 C2C 私聊支持流式 API）",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "partial",
                  "off"
                ],
                "description": "流式模式：partial=打字机效果 | off=关闭（默认 off）"
              },
              "sendMode": {
                "type": "string",
                "enum": [
                  "stream",
                  "static"
                ],
                "description": "文本下发通道（仅 mode=partial 生效）：stream=流式打印机 | static=结束时整条发送"
              }
            }
          },
          "progressCard": {
            "type": "object",
            "additionalProperties": false,
            "description": "Progress Card（进度卡片）配置",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "总开关（默认 true）"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "c2c",
                  "group",
                  "both"
                ],
                "description": "生效范围（默认 c2c）"
              },
              "minIntervalMs": {
                "type": "number",
                "minimum": 0,
                "description": "两次卡片消息的最小间隔毫秒数（默认 1500）"
              },
              "maxPerTurn": {
                "type": "number",
                "minimum": 0,
                "description": "每个 turn 最多发送的卡片条数（默认 3）"
              },
              "maxLines": {
                "type": "number",
                "minimum": 0,
                "description": "checklist 最多渲染行数（默认 8；超出时压缩为完成数 + 当前步 + 待办尾部）"
              },
              "reserveQuota": {
                "type": "number",
                "minimum": 0,
                "description": "为最终回复保留的被动配额槽（默认 1）：剩余槽位 ≤ 此值则跳过发卡，保证正文优先"
              }
            }
          },
          "userAgentSuffix": {
            "type": "string",
            "description": "User-Agent 尾部追加内容（私有化部署标识等）"
          },
          "mediaMaxMb": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "入站媒体解码大小上限（MB，框架通用字段；setup 流程会写入默认 200）"
          },
          "stt": {
            "type": "object",
            "description": "STT（语音转文字）历史遗留配置块——整块被忽略，保留仅为兼容旧配置",
            "additionalProperties": true
          },
          "accounts": {
            "type": "object",
            "description": "多账号配置（每个账号一套凭据、网关与 token 缓存）",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "description": "账号显示名"
                },
                "enabled": {
                  "type": "boolean",
                  "description": "是否启用该账号"
                },
                "appId": {
                  "type": "string",
                  "description": "QQ Bot AppID"
                },
                "clientSecret": {
                  "type": "string",
                  "description": "QQ Bot AppSecret（与 clientSecretFile 互斥）"
                },
